# Copie para keystore.properties (gitignored) e preencha.
# Usado só em builds locais de labRelease. No CI entram os secrets LAB_*.
#
# storeFile é relativo à raiz do repo OrbitLab (não ao módulo app/).

storeFile=orbit-lab-release.keystore
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE
keyAlias=orbitlab
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
